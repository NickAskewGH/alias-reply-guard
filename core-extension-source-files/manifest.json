{
  "manifest_version": 2,
  "name": "Alias Reply Guard",
  "author": "Nick Askew",
  "version": "0.1.1",
  "description": "Create and use a matching sending identity when replying to an email alias.",
  "browser_specific_settings": {
    "gecko": {
      "id": "alias-reply-guard@nickaskew.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "accountsRead",
    "accountsIdentities",
    "compose",
    "messagesRead",
    "storage"
  ],
  "background": {
    "scripts": ["core.js", "background.js"]
  },
  "experiment_apis": {
    "aliasReplyGuardCompose": {
      "schema": "api/aliasReplyGuardCompose/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["aliasReplyGuardCompose"]],
        "script": "api/aliasReplyGuardCompose/implementation.js"
      }
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icon.svg"
  }
}
